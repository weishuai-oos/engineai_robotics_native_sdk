# 1.0 m long, 0.35 m wide, 0.07 m high trapezoidal approximation of the
# rubber M-profile speed-bump module. Local +Y points from the triangle inner
# edge toward the outside of the triangle.
o t800_speed_bump_segment
v -0.5 0.00 0.00
v  0.5 0.00 0.00
v -0.5 0.08 0.07
v  0.5 0.08 0.07
v -0.5 0.27 0.07
v  0.5 0.27 0.07
v -0.5 0.35 0.00
v  0.5 0.35 0.00
f 1 2 4 3
f 3 4 6 5
f 5 6 8 7
f 7 8 2 1
f 1 3 5 7
f 2 8 6 4
